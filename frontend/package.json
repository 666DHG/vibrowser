{
  "name": "vibrowser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.ts smoke.spec.ts",
    "test:live:restart": "playwright test --config playwright.live.config.ts restart.spec.ts",
    "format": "prettier --write src tests *.ts",
    "format:check": "prettier --check src tests *.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.0.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.12",
    "typescript": "~5.7.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
