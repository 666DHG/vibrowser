          "horizontalScroll": null
        },
        {
          "id": "",
          "tag": "nav",
          "text": "一 刻画医疗过程 二 辅助临床诊疗 三 形式化中医理论 代表工作 招募",
          "x": 20,
          "y": 813.9375,
