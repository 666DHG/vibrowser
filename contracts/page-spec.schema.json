{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibrowser PageSpec v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "description",
    "theme",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "theme": {
      "enum": [
        "paper",
        "midnight",
        "terminal",
        "coral",
        "white",
        "graphite",
        "sage"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "design": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "layout": {
              "enum": [
                "classic",
                "editorial",
                "storefront",
                "documentation",
                "community",
                "dashboard",
                "studio",
                "directory"
              ]
            },
            "typography": {
              "enum": [
                "sans",
                "serif",
                "mono",
                "display"
              ]
            },
            "density": {
              "enum": [
                "compact",
                "comfortable",
                "airy"
              ]
            },
            "accent": {
              "enum": [
                "blue",
                "red",
                "green",
                "amber",
                "violet",
                "neutral"
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "text",
        "target",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "navbar",
            "hero",
            "text",
            "card",
            "grid",
            "button",
            "footer",
            "results",
            "ascii",
            "section",
            "list",
            "article",
            "product",
            "thread",
            "stat",
            "quote",
            "code",
            "divider"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6000
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "items": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "meta": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "style": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "variant": {
                  "enum": [
                    "plain",
                    "feature",
                    "outline",
                    "muted"
                  ]
                },
                "placement": {
                  "enum": [
                    "auto",
                    "main",
                    "aside",
                    "full"
                  ]
                },
                "columns": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 4
                }
              }
            }
          ]
        }
      }
    }
  },
  "description": "All nested blocks count toward the 48 block limit; maximum nesting depth is 4. Legacy pages without design/meta/style remain valid. Container, link and content rules are checked by both applications."
}
