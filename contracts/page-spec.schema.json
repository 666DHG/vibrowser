{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibrowser PageSpec v1/v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "description",
    "theme",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "theme": {
      "enum": [
        "paper",
        "midnight",
        "terminal",
        "coral",
        "white",
        "graphite",
        "sage"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "design": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "layout": {
              "enum": [
                "classic",
                "editorial",
                "storefront",
                "documentation",
                "community",
                "dashboard",
                "studio",
                "directory"
              ]
            },
            "typography": {
              "enum": [
                "sans",
                "serif",
                "mono",
                "display"
              ]
            },
            "density": {
              "enum": [
                "compact",
                "comfortable",
                "airy"
              ]
            },
            "accent": {
              "enum": [
                "blue",
                "red",
                "green",
                "amber",
                "violet",
                "neutral"
              ]
            }
          }
        }
      ]
    },
    "entities": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "subjectEntityId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 2048
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "text",
        "target",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "navbar",
            "hero",
            "text",
            "card",
            "grid",
            "button",
            "footer",
            "results",
            "ascii",
            "section",
            "list",
            "article",
            "product",
            "thread",
            "stat",
            "quote",
            "code",
            "divider"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6000
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "items": {
          "type": "array",
          "maxItems": 48,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "meta": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "style": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "variant": {
                  "enum": [
                    "plain",
                    "feature",
                    "outline",
                    "muted"
                  ]
                },
                "placement": {
                  "enum": [
                    "auto",
                    "main",
                    "aside",
                    "full"
                  ]
                },
                "columns": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1,
                  "maximum": 4
                }
              }
            }
          ]
        },
        "entityId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "replyRange": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "integer",
                  "minimum": 1
                },
                "to": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 2048
        },
        "kind": {
          "enum": [
            "thread",
            "article",
            "product",
            "page"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6000
        },
        "author": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "publishedAt": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "replyCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "legacyMeta": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240
        },
        "price": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "amount",
                "currency"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 12
                }
              }
            }
          ]
        }
      }
    }
  },
  "description": "All nested blocks count toward the 48 block limit; maximum nesting depth is 4. Legacy pages without design/meta/style remain valid. Container, link and content rules are checked by both applications. Version 2 binds blocks to canonical URL entities; applications check references, target matching and reply range/count consistency."
}
