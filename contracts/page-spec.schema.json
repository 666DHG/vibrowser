{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibrowser PageSpec v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "description",
    "theme",
    "blocks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "theme": {
      "enum": [
        "paper",
        "midnight",
        "terminal",
        "coral"
      ]
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "text",
        "target",
        "items"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "type": {
          "enum": [
            "navbar",
            "hero",
            "text",
            "card",
            "grid",
            "button",
            "footer",
            "results",
            "ascii"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 6000
        },
        "target": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "items": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    }
  }
}
